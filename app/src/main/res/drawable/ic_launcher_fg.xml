<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!--
      Bow glyph: a knot with two loops and two swept tails.

      Two earlier drafts failed the same way and the reasons are worth keeping:
        * a knot filled in the background colour is invisible, leaving only its
          inner band visible -- at 48px that read as a mouth;
        * loops wide enough to overlap the knot turn the whole thing into a
          mushroom. The loops must stop short of the knot and stay clearly
          narrower than it is tall.

      Everything is white on the crimson background, so it survives the
      launcher's monochrome/themed-icon tinting. All of it sits inside the
      central 72x72 adaptive-icon safe zone (18..90 of this viewport).
    -->

    <!-- left loop: compact teardrop, tip tucked behind the knot at x=46 -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M48,53 C42,47 33,46 29,51 C25,56 29,63 36,64 C41,65 46,61 48,57 Z" />
    <!-- right loop -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M60,53 C66,47 75,46 79,51 C83,56 79,63 72,64 C67,65 62,61 60,57 Z" />

    <!-- knot: a compact upright block, taller than it is wide -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M47,44 L61,44 C64,44 66,46.5 66,49.5 L66,58.5 C66,61.5 64,64 61,64 L47,64 C44,64 42,61.5 42,58.5 L42,49.5 C42,46.5 44,44 47,44 Z" />

    <!-- ribbon tails, swept out and down from under the knot -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M45,62 L37,81 L47,84 L52,64 Z" />
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M63,62 L71,81 L61,84 L56,64 Z" />
</vector>
